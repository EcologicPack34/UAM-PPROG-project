formato effects #ef:Id|name|EffectType|EffectAffects|InfiniteTurns(y/N)|DefaultNumberOfTurns|data
EffectType = {UNKNOWN_EFFECT = 0, REGENERATION = 1, POISON = 2, FIRE = 3}
EffectAffects = {AFFECTS_PLAYER = (p/P), AFFECTS_ALLY = (a/A), AFFECTS_ENEMY = (e/E)}

